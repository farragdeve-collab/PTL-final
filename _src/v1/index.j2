{% extends "base.j2" %}
{% from "icons.j2" import icon %}
{% from "blocks.j2" import open_status, hero_stats, scroll_btn %}
{% block fonts %}{% include "fonts.j2" %}{% endblock %}
{% block head %}
<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.min.js","three/addons/":"https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/"}}</script>
<link rel="preload" as="image" href="assets/sunset-ship.webp">
{% endblock %}

{% block preloader %}
<script>try{if(sessionStorage.getItem("ptl-intro"))document.documentElement.classList.add("intro-seen")}catch(e){}</script>
<div class="preloader" aria-hidden="true">
  <img class="pl-mark" src="assets/mark-light.png" alt="">
  <div class="pl-count"><span>0</span></div>
  <div class="pl-bar"><i></i></div>
</div>
{% endblock %}

{% block main %}
<!-- HERO -->
<section class="hero" id="top">
  <div class="hero-media"><img src="assets/sunset-ship.webp" alt="" data-parallax="8"></div>
  <div class="hero-shade"></div>
  <div class="hero-inner">
    <p class="kicker hero-kicker"><i class="dot"></i><span data-i18n="hero.kicker"></span></p>
    <h1 class="hero-title">
      <span class="line"><span data-i18n="hero.l1"></span></span>
      <span class="line"><span data-i18n="hero.l2"></span></span>
      <span class="line accent"><span data-i18n="hero.l3"></span></span>
    </h1>
    <p class="hero-sub" data-i18n="hero.sub"></p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="contact.html"><span data-i18n="hero.cta1"></span>{{ icon("arrow", "icon icon-dir") }}</a>
      <a class="btn btn-ghost" href="#services"><span data-i18n="hero.cta2"></span></a>
    </div>
  </div>
  <div class="hero-foot">
    {{ hero_stats() }}
    {{ scroll_btn("#ptl") }}
  </div>
</section>

{% if version.final %}
{% include "geo_final.j2" %}
{% else %}
<!-- PTL 3D -->
<section class="ptl-scene" id="ptl">
  <div class="ptl-stage">
    <canvas class="ptl-canvas" aria-hidden="true"></canvas>
    <div class="ptl-fallback" aria-hidden="true">PTL</div>
    <div class="ptl-intro">
      <p class="kicker"><i class="dot"></i><span data-i18n="ptl.kicker"></span></p>
    </div>
    <div class="ptl-panels">
      {% for L in ["P", "T", "L"] %}
      <article class="ptl-panel" data-letter="{{ L }}">
        <p class="ptl-idx"><b>{{ "%02d"|format(loop.index) }}</b> — <span data-i18n="ptl.{{ L }}.w"></span></p>
        <h2><span data-i18n="ptl.{{ L }}.t"></span><i class="dot"></i></h2>
        <p data-i18n="ptl.{{ L }}.d"></p>
      </article>
      {% endfor %}
    </div>
    <div class="ptl-progress"><span class="cur">01</span><i><b></b></i><span>03</span></div>
  </div>
</section>
{% endif %}

<!-- INTRO + STATS -->
<section class="intro section">
  <p class="kicker" data-reveal><i class="dot"></i><span data-i18n="intro.kicker"></span></p>
  <p class="intro-text" data-scrub-words data-i18n="intro.text"></p>
  <div class="stats">
    {% for i in range(1, 5) %}
    <div class="stat" data-reveal data-delay="{{ loop.index0 * 0.08 }}">
      <b class="chrome" data-count data-i18n="s{{ i }}.n"></b>
      <span data-i18n="s{{ i }}.l"></span>
    </div>
    {% endfor %}
  </div>
</section>

{% if version.variant == "grid" %}
{% include "services_grid.j2" %}
{% else %}
<!-- SERVICES RING -->
<section class="ring-scene" id="services">
  <div class="ring-stage">
    <div class="ring-head">
      <div class="ring-count"><b class="cur">01</b><span>/06</span></div>
      <div class="ring-title">
        <p class="kicker"><i class="dot"></i><span data-i18n="services.kicker"></span></p>
        <h2 data-i18n="services.title"></h2>
      </div>
    </div>
    <div class="ring-viewport">
      <div class="ring">
        {% for s in services %}
        <article class="ring-card" style="--i: {{ loop.index0 }}">
          <div class="rc-media"><img src="assets/{{ s.img }}.webp" alt="" loading="lazy"></div>
          <span class="rc-num chrome">{{ "%02d"|format(loop.index) }}</span>
          <div class="rc-body">
            <span class="rc-icon">{{ icon(s.icon) }}</span>
            <h3 data-i18n="{{ s.k }}.t"></h3>
            <p data-i18n="{{ s.k }}.d"></p>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
    <div class="ring-bar"><i></i></div>
  </div>
</section>
{% endif %}

{% if version.final %}
{% include "route_final.j2" %}
{% else %}
<!-- KINETIC PROCESS -->
<section class="kinetic" id="process">
  <div class="kinetic-stage">
    <div class="kinetic-head">
      <p class="kicker"><i class="dot"></i><span data-i18n="process.kicker"></span></p>
      <h2 data-i18n="process.title"></h2>
    </div>
    <div class="kinetic-track">
      {% for p in process %}
      <div class="kw">
        <sup>{{ "%02d"|format(loop.index) }}</sup>
        <span class="kw-word chrome" data-i18n="{{ p }}.t"></span>
        <p data-i18n="{{ p }}.d"></p>
      </div>
      {% endfor %}
    </div>
    <p class="kinetic-note" data-i18n="process.note"></p>
  </div>
</section>
{% endif %}

{% include "modes.j2" %}

<!-- VALUES STACK -->
<section class="values section">
  <div class="section-head">
    <p class="kicker" data-reveal><i class="dot"></i><span data-i18n="values.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="values.title"></h2>
  </div>
  <div class="stack">
    {% for v in values %}
    <article class="stack-card" style="--n: {{ loop.index0 }}">
      <img src="assets/{{ v.img }}.webp" alt="" loading="lazy">
      <div class="stack-body">
        <span class="stack-num chrome">{{ "%02d"|format(loop.index) }}</span>
        <h3 data-i18n="{{ v.k }}.t"></h3>
        <p data-i18n="{{ v.k }}.d"></p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

{% if not version.final %}
<!-- NETWORK -->
<section class="network section" id="network">
  <div class="network-head">
    <div>
      <p class="kicker" data-reveal><i class="dot"></i><span data-i18n="network.kicker"></span></p>
      <h2 class="h2" data-reveal-words data-i18n="network.title"></h2>
    </div>
    <div data-reveal>
      <p class="muted" data-i18n="network.text"></p>
      <p class="hub">{{ icon("pin") }}<span data-i18n="network.hub"></span></p>
    </div>
  </div>
  <div class="regions">
    {% for r in regions %}
    <div class="region" data-reveal>
      <span class="region-n">{{ "%02d"|format(loop.index) }}</span>
      <h3 data-i18n="reg.{{ r.k }}.t"></h3>
      <p data-i18n="reg.{{ r.k }}.c"></p>
      <span class="region-arrow">{{ icon("arrow", "icon icon-dir") }}</span>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

<!-- REVIEWS -->
<section class="reviews section">
  <div class="section-head">
    <p class="kicker" data-reveal><i class="dot"></i><span data-i18n="reviews.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="reviews.title"></h2>
    <p class="muted" data-reveal data-i18n="reviews.sub"></p>
  </div>
  <div class="review-grid">
    {% for r in reviews %}
    <figure class="review" data-reveal data-delay="{{ loop.index0 * 0.1 }}">
      <span class="review-mark chrome">“</span>
      <blockquote data-i18n="{{ r }}.q"></blockquote>
      <figcaption><b data-i18n="{{ r }}.n"></b><span data-i18n="{{ r }}.r"></span></figcaption>
    </figure>
    {% endfor %}
  </div>
</section>

{% include "cta.j2" %}
{% endblock %}

{% block scripts %}
{% if version.final %}
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js"></script>
<script src="main.js"></script>
<script type="module" src="globe.js"></script>
{% else %}
<script src="main.js"></script>
<script type="module" src="ptl3d.js"></script>
{% endif %}
{% endblock %}
