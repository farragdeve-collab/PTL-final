{% extends "base.j2" %}
{% from "blocks.j2" import contact_details, contact_form, map_embed %}
{% block fonts %}{% include "fonts.j2" %}{% endblock %}

{% block main %}
<section class="page-hero page-hero--short">
  <div class="page-hero-media"><img src="assets/port-night.webp" alt="" data-parallax="10"></div>
  <div class="hero-shade"></div>
  <div class="page-hero-inner">
    <p class="kicker" data-reveal><i class="dot"></i><span data-i18n="contact.kicker"></span></p>
    <h1 class="h1" data-reveal-words data-i18n="contact.title"></h1>
    <p class="lead" data-reveal data-i18n="contact.lead"></p>
  </div>
</section>

<section class="contact section">
  <div class="contact-layout">
    <div data-reveal>{{ contact_details() }}</div>
    <div class="glass" data-reveal data-delay="0.1">{{ contact_form() }}</div>
  </div>
  <div data-reveal>{{ map_embed() }}</div>
</section>
{% endblock %}
