{% extends "base.j2" %}
{% from "icons.j2" import icon %}
{% from "blocks.j2" import open_status, hero_stats %}
{% block fonts %}{% include "fonts.j2" %}{% endblock %}
{% block head %}
<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.min.js"}}</script>
{% endblock %}

{% block main %}
<!-- GLOBE: hero + regions share one sticky stage -->
<section class="geo" id="network">
  <div class="geo-stage">
    <canvas class="globe-canvas" aria-hidden="true"></canvas>
    <div class="geo-glow" aria-hidden="true"></div>

    <div class="geo-hero">
      <p class="tag"><span class="pulse"></span><span data-i18n="network.hub"></span></p>
      <h1 class="hero-title">
        <span class="line"><span data-i18n="hero.l1"></span></span>
        <span class="line"><span data-i18n="hero.l2"></span></span>
        <span class="line grad"><span data-i18n="hero.l3"></span></span>
      </h1>
      <p class="hero-sub" data-i18n="hero.sub"></p>
      <div class="actions">
        <a class="btn btn-glow" href="contact.html"><span data-i18n="hero.cta1"></span>{{ icon("arrow", "icon icon-dir") }}</a>
        <a class="btn btn-glass" href="#services"><span data-i18n="hero.cta2"></span></a>
      </div>
      {{ hero_stats(3) }}
    </div>

    <div class="geo-regions">
      <div class="geo-head">
        <p class="kicker"><span data-i18n="network.kicker"></span></p>
        <h2 data-i18n="network.title"></h2>
      </div>
      {% for r in regions %}
      <article class="geo-panel" data-region="{{ r.k }}">
        <span class="gp-n">{{ "%02d"|format(loop.index) }} / {{ "%02d"|format(regions|length) }}</span>
        <h3 data-i18n="reg.{{ r.k }}.t"></h3>
        <p data-i18n="reg.{{ r.k }}.c"></p>
        {% if r.n %}<span class="gp-count"><b>{{ r.n }}</b> {{ icon("globe") }}</span>{% endif %}
      </article>
      {% endfor %}
      <div class="geo-dots">{% for r in regions %}<i></i>{% endfor %}</div>
    </div>
    <div class="scroll-hint"><i></i><span data-i18n="hero.scroll"></span></div>
  </div>
</section>

<!-- NETWORK TEXT -->
<section class="net-text section">
  <div class="split">
    <p class="kicker" data-reveal><span data-i18n="intro.kicker"></span></p>
    <p class="big-text" data-scrub-words data-i18n="intro.text"></p>
  </div>
  <div class="split">
    <span></span>
    <p class="muted" data-reveal data-i18n="network.text"></p>
  </div>
</section>

<!-- SERVICES BENTO -->
<section class="services section" id="services">
  <div class="sec-head">
    <p class="kicker" data-reveal><span data-i18n="services.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="services.title"></h2>
  </div>
  <div class="bento">
    {% for s in services %}
    <article class="bento-card b{{ loop.index }}" data-reveal data-delay="{{ (loop.index0 % 3) * 0.08 }}">
      <img src="assets/{{ s.img }}.jpg" alt="" loading="lazy">
      <div class="bento-body">
        <span class="bento-icon">{{ icon(s.icon) }}</span>
        <span class="bento-n">{{ "%02d"|format(loop.index) }}</span>
        <h3 data-i18n="{{ s.k }}.t"></h3>
        <p data-i18n="{{ s.k }}.d"></p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<!-- ROUTE (drawn path) -->
<section class="route section" id="process">
  <div class="sec-head center">
    <p class="kicker" data-reveal><span data-i18n="process.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="process.title"></h2>
  </div>
  <div class="route-map">
    <svg class="route-svg" viewBox="0 0 1000 1200" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="routeGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#5fd4ff"/><stop offset="1" stop-color="#2a7fff"/>
        </linearGradient>
      </defs>
      <path class="route-base" d="M500 0 C 500 120, 390 120, 390 200 S 610 320, 610 400 S 390 520, 390 600 S 610 720, 610 800 S 390 920, 390 1000 S 500 1080, 500 1200"/>
      <path class="route-line" d="M500 0 C 500 120, 390 120, 390 200 S 610 320, 610 400 S 390 520, 390 600 S 610 720, 610 800 S 390 920, 390 1000 S 500 1080, 500 1200"/>
    </svg>
    <div class="route-truck" aria-hidden="true">{{ icon("truck") }}</div>
    {% for p in process %}
    <div class="station s{{ loop.index }}">
      <span class="st-dot"></span>
      <div class="st-card">
        <span class="st-n">{{ "%02d"|format(loop.index) }}</span>
        <h3 data-i18n="{{ p }}.t"></h3>
        <p data-i18n="{{ p }}.d"></p>
      </div>
    </div>
    {% endfor %}
  </div>
  <p class="route-note" data-reveal>{{ icon("clock") }}<span data-i18n="process.note"></span></p>
</section>

<!-- MODES ACCORDION -->
<section class="modes section">
  <div class="sec-head">
    <p class="kicker" data-reveal><span data-i18n="modes.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="cargo.title"></h2>
  </div>
  <div class="mode-row" data-reveal>
    {% for m in modes %}
    <article class="mode {{ 'is-open' if loop.first }}" tabindex="0">
      <img src="assets/{{ m.img }}.jpg" alt="" loading="lazy">
      <div class="mode-body">
        <span class="mode-icon">{{ icon({"land":"truck","sea":"ship","air":"plane","post":"parcel"}[m.k]) }}</span>
        <h3 data-i18n="mode.{{ m.k }}"></h3>
        <p data-i18n="mode.{{ m.k }}.d"></p>
      </div>
    </article>
    {% endfor %}
  </div>
  <div class="cargo-tags" data-reveal>
    {% for c in cargo %}<span data-i18n="{{ c }}"></span>{% endfor %}
  </div>
</section>

<!-- VALUES -->
<section class="values section">
  <div class="sec-head">
    <p class="kicker" data-reveal><span data-i18n="values.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="values.title"></h2>
  </div>
  <div class="value-grid">
    {% for v in values %}
    <article class="value glow-card" data-reveal data-delay="{{ loop.index0 * 0.1 }}">
      <span class="value-n">{{ "%02d"|format(loop.index) }}</span>
      <h3 data-i18n="{{ v.k }}.t"></h3>
      <p data-i18n="{{ v.k }}.d"></p>
    </article>
    {% endfor %}
  </div>
</section>

<!-- REVIEWS -->
<section class="reviews section">
  <div class="sec-head">
    <p class="kicker" data-reveal><span data-i18n="reviews.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="reviews.title"></h2>
  </div>
  <div class="review-grid">
    {% for r in reviews %}
    <figure class="review glow-card" data-reveal data-delay="{{ loop.index0 * 0.1 }}">
      <div class="stars" aria-hidden="true">★★★★★</div>
      <blockquote data-i18n="{{ r }}.q"></blockquote>
      <figcaption><span class="avatar">{{ icon("quote") }}</span><span><b data-i18n="{{ r }}.n"></b><small data-i18n="{{ r }}.r"></small></span></figcaption>
    </figure>
    {% endfor %}
  </div>
</section>

<!-- CTA -->
<section class="cta section">
  <div class="cta-card">
    <img class="cta-photo" src="assets/cranes-sunset.jpg" alt="" loading="lazy">
    <div class="cta-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="kicker" data-reveal><span data-i18n="cta.kicker"></span></p>
    <h2 class="h1" data-reveal-words data-i18n="cta.title"></h2>
    <p class="muted" data-reveal data-i18n="cta.text"></p>
    <div class="actions" data-reveal>
      <a class="btn btn-glow" href="contact.html"><span data-i18n="cta.btn"></span>{{ icon("arrow", "icon icon-dir") }}</a>
      <a class="btn btn-glass" data-wa-link href="https://wa.me/{{ contact.whatsapp }}" target="_blank" rel="noopener">{{ icon("whatsapp") }}<span data-i18n="cta.wa"></span></a>
    </div>
    <div data-reveal>{{ open_status() }}</div>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js"></script>
<script src="main.js"></script>
<script type="module" src="globe.js"></script>
{% endblock %}
