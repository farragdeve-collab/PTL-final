{% extends "base.j2" %}
{% from "icons.j2" import icon %}
{% from "blocks.j2" import faq_list, open_status %}
{% block fonts %}{% include "fonts.j2" %}{% endblock %}

{% block main %}
<section class="page-hero">
  <div class="page-hero-bg" aria-hidden="true"><img src="assets/yard-night.webp" alt="" data-parallax="10"></div>
  <div class="page-hero-inner">
    <p class="kicker" data-reveal><span data-i18n="about.kicker"></span></p>
    <h1 class="h1" data-reveal-words data-i18n="about.title"></h1>
    <p class="lead" data-reveal data-i18n="about.lead"></p>
    <div class="hero-chips" data-reveal>
      {% for i in range(1, 5) %}<div class="chip"><b data-count data-i18n="s{{ i }}.n"></b><span data-i18n="s{{ i }}.l"></span></div>{% endfor %}
    </div>
  </div>
</section>

<section class="net-text section">
  <div class="split">
    <p class="kicker" data-reveal><span data-i18n="intro.kicker"></span></p>
    <p class="big-text" data-scrub-words data-i18n="about.text"></p>
  </div>
</section>

<section class="values section">
  <div class="sec-head">
    <p class="kicker" data-reveal><span data-i18n="values.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="values.title"></h2>
  </div>
  <div class="value-grid">
    {% for v in values %}
    <article class="value glow-card" data-reveal data-delay="{{ loop.index0 * 0.1 }}">
      <span class="value-n">{{ "%02d"|format(loop.index) }}</span>
      <h3 data-i18n="{{ v.k }}.t"></h3>
      <p data-i18n="{{ v.k }}.d"></p>
    </article>
    {% endfor %}
  </div>
</section>

<section class="regions-list section" id="network">
  <div class="sec-head">
    <p class="kicker" data-reveal><span data-i18n="network.kicker"></span></p>
    <h2 class="h2" data-reveal-words data-i18n="network.title"></h2>
    <p class="muted" data-reveal data-i18n="network.text"></p>
  </div>
  <div class="region-grid">
    {% for r in regions %}
    <article class="region glow-card" data-reveal data-delay="{{ (loop.index0 % 3) * 0.08 }}">
      <span class="gp-n">{{ "%02d"|format(loop.index) }}</span>
      <h3 data-i18n="reg.{{ r.k }}.t"></h3>
      <p data-i18n="reg.{{ r.k }}.c"></p>
    </article>
    {% endfor %}
    <article class="region glow-card hq" data-reveal>
      {{ icon("pin") }}
      <h3 data-i18n="network.hub"></h3>
      <p data-i18n="contact.address"></p>
    </article>
  </div>
</section>

<section class="faq-section section" id="faq">
  <div class="faq-layout">
    <div class="sec-head sticky-head">
      <p class="kicker" data-reveal><span data-i18n="faq.kicker"></span></p>
      <h2 class="h2" data-reveal-words data-i18n="faq.title"></h2>
    </div>
    {{ faq_list() }}
  </div>
</section>

<section class="cta section">
  <div class="cta-card">
    <img class="cta-photo" src="assets/cranes-dusk.webp" alt="" loading="lazy">
    <div class="cta-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
    <p class="kicker" data-reveal><span data-i18n="cta.kicker"></span></p>
    <h2 class="h1" data-reveal-words data-i18n="cta.title"></h2>
    <p class="muted" data-reveal data-i18n="cta.text"></p>
    <div class="actions" data-reveal>
      <a class="btn btn-glow" href="contact.html"><span data-i18n="cta.btn"></span>{{ icon("arrow", "icon icon-dir") }}</a>
      <a class="btn btn-glass" data-wa-link href="https://wa.me/{{ contact.whatsapp }}" target="_blank" rel="noopener">{{ icon("whatsapp") }}<span data-i18n="cta.wa"></span></a>
    </div>
    <div data-reveal>{{ open_status() }}</div>
  </div>
</section>
{% endblock %}
