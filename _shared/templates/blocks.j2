{% from "icons.j2" import icon %}

{% macro open_status() -%}
<span class="open-status" data-open-status><i></i><span data-open-label></span><small data-open-time></small></span>
{%- endmacro %}

{% macro faq_list() -%}
<div class="faq" data-faq>
  {% for q in faqs %}
  <div class="faq-item">
    <button class="faq-q" type="button" aria-expanded="false">
      <span class="faq-n">{{ "%02d"|format(loop.index) }}</span>
      <span data-i18n="{{ q }}.q"></span>
      <span class="faq-icon">{{ icon("plus") }}</span>
    </button>
    <div class="faq-a"><p data-i18n="{{ q }}.a"></p></div>
  </div>
  {% endfor %}
</div>
{%- endmacro %}

{% macro contact_details() -%}
<div class="contact-details">
  <div class="cd-item">
    <span class="cd-icon">{{ icon("pin") }}</span>
    <div><h2 data-i18n="contact.address.l"></h2><p data-i18n="contact.address"></p>
      <a class="cd-link" href="{{ contact.map }}" target="_blank" rel="noopener"><span data-i18n="contact.map"></span> {{ icon("arrow", "icon icon-dir") }}</a></div>
  </div>
  <div class="cd-item">
    <span class="cd-icon">{{ icon("clock") }}</span>
    <div><h2 data-i18n="contact.hours.l"></h2><p data-i18n="contact.hours"></p>{{ open_status() }}</div>
  </div>
  <div class="cd-item">
    <span class="cd-icon">{{ icon("phone") }}</span>
    <div><h2 data-i18n="contact.phone.l"></h2>
      {% for p in contact.phones %}<a href="tel:{{ p.tel }}" dir="ltr">{{ p.label }}</a>{% endfor %}</div>
  </div>
  <div class="cd-item">
    <span class="cd-icon">{{ icon("mail") }}</span>
    <div><h2 data-i18n="contact.email.l"></h2>
      {% for e in contact.emails %}<a href="mailto:{{ e }}" dir="ltr">{{ e }}</a>{% endfor %}</div>
  </div>
  <div class="cd-item">
    <span class="cd-icon">{{ icon("whatsapp") }}</span>
    <div><h2 data-i18n="contact.wa.l"></h2>
      <a data-wa-link href="https://wa.me/{{ contact.whatsapp }}" target="_blank" rel="noopener" dir="ltr">+{{ contact.whatsapp }}</a></div>
  </div>
</div>
{%- endmacro %}

{% macro contact_form() -%}
<form class="contact-form" data-wa-form novalidate>
  <h2 data-i18n="form.title"></h2>
  <p class="form-sub" data-i18n="form.sub"></p>
  <div class="form-grid">
    <label><span data-i18n="form.name"></span><input name="name" autocomplete="name" required></label>
    <label><span data-i18n="form.phone"></span><input name="phone" type="tel" autocomplete="tel" dir="ltr" required></label>
    <label><span data-i18n="form.email"></span><input name="email" type="email" autocomplete="email" dir="ltr"></label>
    <label><span data-i18n="form.service"></span>
      <select name="service">
        {% for s in services %}<option data-i18n="{{ s.k }}.t"></option>{% endfor %}
      </select>
    </label>
    <label class="full"><span data-i18n="form.msg"></span><textarea name="message" rows="4"></textarea></label>
  </div>
  <p class="form-error" role="alert" hidden></p>
  <button class="btn btn-primary" type="submit">{{ icon("whatsapp") }}<span data-i18n="form.send"></span></button>
  <p class="form-note" data-i18n="form.note"></p>
</form>
{%- endmacro %}

{% macro map_embed() -%}
<div class="map-embed">
  <iframe src="{{ contact.mapEmbed }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map"></iframe>
</div>
{%- endmacro %}

{% macro hero_stats(n=4) -%}
<div class="hero-stats">
  {% for ic in ["award", "globe", "ship", "box"][:n] %}
  <div class="hs">
    <span class="hs-icon">{{ icon(ic) }}</span>
    <span class="hs-text"><b data-i18n="s{{ loop.index }}.n"></b><small data-i18n="s{{ loop.index }}.l"></small></span>
  </div>
  {% endfor %}
</div>
{%- endmacro %}

{% macro scroll_btn(target) -%}
<a class="scroll-btn" href="{{ target }}"><span class="scroll-circle">{{ icon("arrow-down") }}</span><span data-i18n="hero.scroll"></span></a>
{%- endmacro %}
