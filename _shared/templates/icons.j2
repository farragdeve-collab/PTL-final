{% macro icon(name, cls="icon") -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if name == "globe" %}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.4 5.8 12 3z"/>
{%- elif name == "stamp" %}<path d="M9 3h6l-1 7h-4L9 3zM5 14h14v3H5zM7 20h10"/>
{%- elif name == "crane" %}<path d="M4 21V5l10-2v3M4 5h17M14 6v6M12 12h4v3h-4zM2 21h10"/>
{%- elif name == "truck" %}<path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>
{%- elif name == "chat" %}<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>
{%- elif name == "box" %}<path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/>
{%- elif name == "arrow" %}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- elif name == "arrow-down" %}<path d="M12 5v14M6 13l6 6 6-6"/>
{%- elif name == "arrow-up" %}<path d="M12 19V5M6 11l6-6 6 6"/>
{%- elif name == "phone" %}<path d="M5 3h4l2 5-2.5 1.5a11 11 0 005 5L15 12l5 2v4a2 2 0 01-2 2A16 16 0 013 5a2 2 0 012-2z"/>
{%- elif name == "mail" %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
{%- elif name == "pin" %}<path d="M12 21s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/>
{%- elif name == "clock" %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- elif name == "shield" %}<path d="M12 3l7 3v6c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>
{%- elif name == "award" %}<circle cx="12" cy="9" r="6"/><path d="M8.5 14L7 21l5-3 5 3-1.5-7"/>
{%- elif name == "plus" %}<path d="M12 5v14M5 12h14"/>
{%- elif name == "quote" %}<path d="M9 7H5v6h4v4H5M19 7h-4v6h4v4h-4" />
{%- elif name == "whatsapp" %}<path d="M4 20l1.3-4A8 8 0 1112 20a8 8 0 01-4-1z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1c-1-.5-2-1.5-2.5-2.5l1-1-1-2z"/>
{%- elif name == "ship" %}<path d="M3 15l2 5h14l2-5zM6 15V9h12v6M9 9V5h6v4"/>
{%- elif name == "plane" %}<path d="M10 14l-6 2v-2l6-4V5a2 2 0 014 0v5l6 4v2l-6-2v4l2 2v1l-4-1-4 1v-1l2-2z"/>
{%- elif name == "parcel" %}<rect x="4" y="7" width="16" height="13" rx="1"/><path d="M4 11h16M10 7V4h4v3"/>
{%- endif -%}
</svg>
{%- endmacro %}
